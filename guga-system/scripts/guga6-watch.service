[Unit]
Description=Guga six watch (guests' access journal — who connected, how, what ran)
After=network-online.target guga-join-api.service
Wants=network-online.target guga-join-api.service

[Service]
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/.hermes/scripts/guga6_watch.py
Restart=on-failure
RestartSec=5

# —— 低成本硬化（照 guga-group-relay.service 那套）——
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu /tmp
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
