[Unit]
Description=Guga group relay (wakes a guga when the master speaks in the 咕嘎群)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/.hermes/scripts/group_relay.py
Restart=on-failure
RestartSec=5

# —— 低成本硬化（照 guga-remote-api.service 那套；不设 ProtectHome，要读写 ~/.hermes） ——
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu /tmp
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
